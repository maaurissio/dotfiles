{
  "output": "HDMI-A-1",
  "layer": "top",
  "position": "top",
  "width": 1080,
  "height": 48,
  "margin": "5 0",

  "group/gright2": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "network"]
  },

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/gright2", "custom/ctlcenter"],

  "include": ["~/.config/waybar/modules.jsonc"]
}