* {
    bg: rgba(30, 30, 46, 0.88);
    fg: #cdd6f4;
    accent: #d85a7a;
    selected: #d85a7a;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 850px;
    height: 600px;
    border-radius: 18px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
}

mainbox {
    padding: 16px;
    spacing: 12px;
}

inputbar {
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(49, 50, 68, 0.9);
}

entry {
    placeholder: "Buscar wallpaper...";
}

listview {
    columns: 3;
    lines: 3;
    spacing: 12px;
}

element {
    orientation: vertical;
    padding: 12px;
    border-radius: 14px;
    background-color: rgba(49, 50, 68, 0.75);
}

element selected {
    background-color: @selected;
}

element-icon {
    size: 150px;
    border-radius: 12px;
}

element-text {
    horizontal-align: 0.5;
    margin: 8px 0px 0px 0px;
}